{
	"compilerOptions": {
		"target": "ES2019",
		"lib": ["ES2019"],
		"module": "Node16",
		"types": [],
		"strict": true,
		"declaration": true,
		"stripInternal": true,
		"sourceMap": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"outDir": "out",
		"rootDir": "src"
	},
	"include": ["src"]
}
