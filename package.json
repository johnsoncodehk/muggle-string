{
	"name": "muggle-string",
	"version": "1.0.2",
	"description": "Ranked, conflict-free rewrites of a source text, rendered as format-neutral pieces",
	"type": "module",
	"main": "./out/cjs/index.js",
	"types": "./out/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./out/index.d.ts",
				"default": "./out/index.js"
			},
			"require": {
				"types": "./out/cjs/index.d.ts",
				"default": "./out/cjs/index.js"
			}
		}
	},
	"sideEffects": false,
	"engines": {
		"node": ">=12"
	},
	"license": "MIT",
	"files": [
		"out/**/*.js",
		"out/**/*.d.ts",
		"out/cjs/package.json"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/johnsoncodehk/muggle-string.git"
	},
	"scripts": {
		"build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('out/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\\\n')\"",
		"prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('out/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\\\n')\"",
		"test": "vitest run",
		"bench": "node bench/run.mjs"
	},
	"devDependencies": {
		"@jridgewell/trace-mapping": "^0.3.31",
		"@types/node": "^26.0.1",
		"muggle-string-0.4": "npm:muggle-string@0.4.1",
		"typescript": "7.1.0-beta",
		"vitest": "latest"
	}
}
